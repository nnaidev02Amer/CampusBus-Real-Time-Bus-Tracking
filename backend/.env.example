PORT=5000
# Local MongoDB only: install MongoDB Community Server and start the service.
# Each developer keeps their own local database; no cloud database is required or used.
MONGO_URI=mongodb://127.0.0.1:27017/campusbus
JWT_SECRET=replace_with_a_long_random_string
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SOCKET_IO_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# LAN / phone testing: also allow the page origin served by your laptop, e.g. (use your laptop's IP):
#   CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.50:5173
#   SOCKET_IO_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.50:5173
LOCATION_STALE_MS=120000
BUS_STOPPED_SPEED_THRESHOLD_KMH=1.5
BUS_STOPPED_DURATION_MS=90000
BUS_STOP_PROXIMITY_METERS=120
FIREBASE_PROJECT_ID=campusbus-9e9a0
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...} # Optional for service account credentials
SUPABASE_URL=https://your-project-id.supabase.co
# Secret key from Supabase Dashboard > Project Settings > API (supports sb_secret_... or legacy service_role JWT eyJ...)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_secret_key_here
SUPABASE_BUCKET=PrashantiCampusBus

# --- Generate a strong JWT secret with:
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# --- Optional settings (defaults shown; uncomment to change) ---
# How often (ms) the server checks for buses that stopped sending GPS (signal-lost notifications)
# SIGNAL_CHECK_MS=15000
# A bus is "approaching" a student's stop when its ETA is at most this many minutes
# NOTIFY_APPROACH_MINUTES=5
# Allow drivers to run the prototype "test mode" (simulated GPS). Set to false to disable.
# DRIVER_TEST_MODE=true
# Road routing (OSRM) and address search (Nominatim) - free OpenStreetMap services, no API key.
# The public servers are for light/prototype use; point these at your own instances for heavy use.
# OSRM_BASE_URL=https://router.project-osrm.org
# OSRM_TIMEOUT_MS=8000
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
